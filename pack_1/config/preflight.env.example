# Copy this file to config/preflight.env and fill in environment-specific values.
# Do NOT commit the real preflight.env file if it contains sensitive identifiers.
# Add config/preflight.env to .gitignore.

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_KEYVAULT_NAME=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=

# Azure AI Endpoint
# Example: https://your-azure-openai-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Azure DevOps
ADO_ORG=
ADO_PROJECT=
ADO_REPO=
ADO_AGENT_POOL_NAME=
ADO_SERVICE_CONNECTION_NAME=

# Preflight output location
PREFLIGHT_OUTPUT_DIR=reports/preflight
