## `orchestration/code-scaffolds/single_agent_scaffold.py.example`

```python
"""
Single Agent Scaffold - Azure AI Inference
Pattern: ORCH-PAT-001 (Single Agent)

This scaffold demonstrates a basic chat completion agent with:
- DefaultAzureCredential authentication
- Retry with exponential backoff
- Fallback model support
- Token tracking
- Structured logging

Adapt this for your specific use case.
"""

import os
import time
import logging
import json
from typing import Optional
from dataclasses import dataclass

from azure.identity import DefaultAzureCredential
from azure.ai.inference import ChatCompletionsClient
from azure.ai.inference.models import (
    ChatRequestMessage,
    SystemMessage,
    UserMessage,
    AssistantMessage,
)
from azure.core.exceptions import (
    HttpResponseError,
    ServiceRequestTimeoutError,
)

# ---------------------------------------------------------------------------
# Configuration - Replace with your actual values
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT = os.environ.get("AZURE_OPENAI_ENDPOINT", "https://your-resource.openai.azure.com")
AZURE_OPENAI_API_VERSION = "2024-06-01"
PRIMARY_MODEL = "gpt-4o"  # or your deployment name
FALLBACK_MODEL = "gpt-4o-mini"  # fallback for quota exhaustion

MAX_RETRIES = 3
INITIAL_BACKOFF_SECONDS = 1.0
REQUEST_TIMEOUT_SECONDS = 60

# ---------------------------------------------------------------------------
# Logging Setup
# ---------------------------------------------------------------------------
logger = logging.getLogger(__name__)
logging.basicConfig(level=logging.INFO)


def log_structured(event: str, **kwargs):
    """Emit a structured JSON log line."""
    log_entry = {
        "event": event,
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        **kwargs,
    }
    logger.info(json.dumps(log_entry))


# ---------------------------------------------------------------------------
# Client Initialization
# ---------------------------------------------------------------------------
def create_client() -> ChatCompletionsClient:
    """Create an authenticated ChatCompletionsClient using Managed Identity."""
    credential = DefaultAzureCredential()
    return ChatCompletionsClient(
        endpoint=AZURE_OPENAI_ENDPOINT,
        credential=credential,
        api_version=AZURE_OPENAI_API_VERSION,
    )


# ---------------------------------------------------------------------------
# Retry Logic
# ---------------------------------------------------------------------------
@dataclass
class AgentResponse:
    content: str
    model_used: str
    tokens_input: int
    tokens_output: int
    attempts: int
    fallback_used: bool


def call_llm_with_retry(
    client: ChatCompletionsClient,
    messages: list,
    model: str = PRIMARY_MODEL,
    session_id: str = "unknown",
    correlation_id: str = "unknown",
) -> AgentResponse:
    """
    Call the LLM with exponential backoff retry and fallback model support.
    """
    backoff = INITIAL_BACKOFF_SECONDS
    attempts = 0
    fallback_used = False

    for attempt in range(1, MAX_RETRIES + 1):
        attempts = attempt
        try:
            start_time = time.time()

            response = client.complete(
                messages=messages,
                model=model,
                timeout=REQUEST_TIMEOUT_SECONDS,
            )

            duration_ms = (time.time() - start_time) * 1000

            # Track metrics
            log_structured(
                "llm_call_success",
                session_id=session_id,
                correlation_id=correlation_id,
                model=model,
                duration_ms=round(duration_ms, 2),
                tokens_input=response.usage.prompt_tokens,
                tokens_output=response.usage.completion_tokens,
                attempt=attempt,
            )

            return AgentResponse(
                content=response.choices[0].message.content,
                model_used=model,
                tokens_input=response.usage.prompt_tokens,
                tokens_output=response.usage.completion_tokens,
                attempts=attempts,
                fallback_used=fallback_used,
            )

        except HttpResponseError as e:
            status_code = e.status_code

            # 429 = Rate limited, 500/503 = Server error → retry
            if status_code in (429, 500, 503) and attempt < MAX_RETRIES:
                log_structured(
                    "llm_call_retry",
                    session_id=session_id,
                    correlation_id=correlation_id,
                    status_code=status_code,
                    attempt=attempt,
                    backoff_seconds=backoff,
                )
                time.sleep(backoff)
                backoff *= 2  # Exponential backoff
                continue

            # 429 after all retries → try fallback model
            if status_code == 429 and not fallback_used and FALLBACK_MODEL:
                log_structured(
                    "llm_fallback_triggered",
                    session_id=session_id,
                    correlation_id=correlation_id,
                    primary_model=model,
                    fallback_model=FALLBACK_MODEL,
                )
                model = FALLBACK_MODEL
                fallback_used = True
                backoff = INITIAL_BACKOFF_SECONDS  # Reset backoff
                continue

            # Non-retryable error
            log_structured(
                "llm_call_error",
                session_id=session_id,
                correlation_id=correlation_id,
                status_code=status_code,
                error=str(e),
                attempt=attempt,
            )
            raise

        except ServiceRequestTimeoutError:
            if attempt < MAX_RETRIES:
                log_structured(
                    "llm_call_timeout_retry",
                    session_id=session_id,
                    correlation_id=correlation_id,
                    attempt=attempt,
                    backoff_seconds=backoff,
                )
                time.sleep(backoff)
                backoff *= 2
                continue

            log_structured(
                "llm_call_timeout_final",
                session_id=session_id,
                correlation_id=correlation_id,
                attempt=attempt,
            )
            raise

    raise RuntimeError("LLM call failed after all retries and fallback attempts")


# ---------------------------------------------------------------------------
# Agent Class
# ---------------------------------------------------------------------------
class SingleAgent:
    """
    A simple single-agent conversational AI.
    
    Adapt this class for your specific use case:
    - Add your system prompt
    - Add your business logic
    - Add your guardrails (see guardrail_integration_scaffold.py.example)
    - Add your session state (see session_state_scaffold.py.example)
    """

    def __init__(self, system_prompt: str):
        self.client = create_client()
        self.system_prompt = system_prompt

    def chat(
        self,
        user_message: str,
        conversation_history: Optional[list] = None,
        session_id: str = "unknown",
        correlation_id: str = "unknown",
    ) -> AgentResponse:
        """
        Process a user message and return the agent response.
        """
        messages = [
            SystemMessage(content=self.system_prompt),
        ]

        # Add conversation history if provided
        if conversation_history:
            messages.extend(conversation_history)

        # Add current user message
        messages.append(UserMessage(content=user_message))

        # Call LLM with retry and fallback
        response = call_llm_with_retry(
            client=self.client,
            messages=messages,
            session_id=session_id,
            correlation_id=correlation_id,
        )

        return response


# ---------------------------------------------------------------------------
# Example Usage
# ---------------------------------------------------------------------------
if __name__ == "__main__":
    # Example system prompt - replace with your actual prompt
    SYSTEM_PROMPT = """
    You are a helpful assistant. Answer questions accurately and concisely.
    If you don't know the answer, say so clearly.
    """

    agent = SingleAgent(system_prompt=SYSTEM_PROMPT)

    # Example conversation
    response = agent.chat(
        user_message="What is the capital of France?",
        session_id="demo-session-001",
        correlation_id="demo-corr-001",
    )

    print(f"Response: {response.content}")
    print(f"Model used: {response.model_used}")
    print(f"Tokens: {response.tokens_input} in, {response.tokens_output} out")
    print(f"Attempts: {response.attempts}")
    print(f"Fallback used: {response.fallback_used}")
